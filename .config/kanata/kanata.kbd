(defcfg
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "EPOMAKER Split65"
  )
  ;; process-unmapped-keys allows keys not in defsrc to pass through
  process-unmapped-keys yes
  concurrent-tap-hold yes
  delegate-to-first-layer yes
  ;; early-tap-input yes
)

(defvar
  tap-timeout 200
  hold-timeout 200
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  ;; Added 'f20' to represent your left split spacebar
  fn   lctl lalt lmet      f20  spc             rmet ralt left down rght
)

(defalias
  ;; Multi-mapping to trigger the macOS Emoji Picker
  emj (multi lctl lmet spc)

  dict f18  ;; Maps your Voice Jotter to F18
  dnd  f19  ;; Maps your Moon icon to F19

  ;; Tap for ESC | Hold for Ctrl (Ctrl fires early if another key is tapped while held)
  esc_ctl (tap-hold-release $tap-timeout $hold-timeout esc lctl)
  
  ;; Right Space: Tap for Space | Hold for Hyper (Cmd+Alt+Ctrl)
  spc_hyper (tap-hold $tap-timeout $hold-timeout spc (multi lctl lmet lalt))

  ;; ==========================================
  ;; LAYER TOGGLES
  ;; ==========================================

  ;; Tap for Emoji, Hold for the Function Layer
  fn_emj (tap-hold $tap-timeout $hold-timeout @emj (layer-toggle fn_layer))

  ;; --- NEW SPLIT SPACEBAR ALIASES ---
  ;; Left Space: Tap for Return | Hold for Layer 1
  ret_l1 (tap-hold $tap-timeout $hold-timeout ret (layer-toggle layer1))

  spc_l2 (layer-toggle layer2)     ;; Hold for Layer 2

  ;; ==========================================
  ;; LAYER 1: MOUSE MOVEMENT & CLICKS
  ;; ==========================================
  m_u  (movemouse-accel-up 4 1000 1 5)
  m_d  (movemouse-accel-down 4 1000 1 5)
  m_l  (movemouse-accel-left 4 1000 1 5)
  m_r  (movemouse-accel-right 4 1000 1 5)

  ;; ==========================================
  ;; LAYER 2: MOUSE SCROLL WHEEL
  ;; ==========================================
  mw_u (mwheel-up 50 60)
  mw_d (mwheel-down 50 60)
  mw_l (mwheel-left 50 60)
  mw_r (mwheel-right 50 60)
)

;; The default base layer
(deflayer base
  _    brdn brup C-up M-spc @dict @dnd prev pp next mute vold volu _
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab q    w    e    r    t    y    u    i    o    p    [    ]    \
  @esc_ctl a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  ;; Mapped @ret_l1 and @spc_hyper to the two space positions
  @fn_emj lctl lalt lmet   @ret_l1 @spc_hyper   rmet ralt left down rght
)

;; You MUST define the layer that @fn_emj toggles
(deflayer fn_layer
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
  _    brdn brup C-up M-spc @dict @dnd prev pp next mute vold volu del
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    pgup
  ;; Added an extra underscore to match the new 11-key bottom row
  _    _    _    _         _       _            _          _    home pgdn end
)

;; -----------------------------------------------------------------------------
;; LAYER 1 (Mouse Movement, Clicks & Arrows)
;; -----------------------------------------------------------------------------
(deflayer layer1
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    @m_u _    mrgt _    _    _    _    _    _    _    _
  _    _    @m_l @m_d @m_r mlft left down up   rght _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  ;; Kept @spc_l2 on the right space position
  _    _    _    _         _       @spc_l2         _          _    _    _    _
)

;; -----------------------------------------------------------------------------
;; LAYER 2 (Scroll Wheel)
;; -----------------------------------------------------------------------------
(deflayer layer2
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    @mw_u _    _    _    _    _    _    _    _    _    _
  _    _    @mw_l @mw_d @mw_r _  _   _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  ;; Added an extra underscore to match the new 11-key bottom row
  _    _    _    _         _       _            _          _    _    _    _
)
